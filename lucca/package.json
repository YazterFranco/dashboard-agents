{
  "name": "lucca-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/web",
    "dev:server": "NODE_OPTIONS=--disable-warning=ExperimentalWarning LUCCA_DEMO=1 tsx packages/server/src/index.ts",
    "dev:web": "npm run dev -w @lucca/web",
    "build": "npm run build -w @lucca/web && npm run build -w @lucca/server",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning node packages/server/dist/lucca.mjs",
    "e2e": "node e2e/layout.cjs",
    "e2e:functional": "node e2e/functional.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
