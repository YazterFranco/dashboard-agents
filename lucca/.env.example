# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.
ANTHROPIC_API_KEY=
MEREB_URL=
MEREB_USER=
MEREB_PASSWORD=
# Solo si tu cuenta de Mereb muestra más de un estudiante:
MEREB_STUDENT=
# URL con la que la tablet y el celular llegan a esta computadora, por ejemplo http://192.168.1.50:4830
LUCCA_PUBLIC_URL=
LUCCA_PORT=4830
# 1 = carga tareas de ejemplo (solo para probar)
LUCCA_DEMO=0
TZ=America/Panama
